# ============================================================
# InterviewVault Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# ============================================================

# --- Database (Supabase Postgres) ---
# Get this from: Supabase Dashboard -> Project -> Settings -> Database
# -> Connection String -> URI (use "Session pooler" mode for local dev)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:Praveenkumar%4007@db.pmkyucxxwalpbviczuzb.supabase.co:5432/postgres

# --- JWT Auth ---
# Generate a strong random secret, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=praveenkumarsnewprojectsecretkey1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Gemini AI ---
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- CORS ---
# The URL your frontend runs on locally (Vite default)
FRONTEND_ORIGIN=http://localhost:5173
